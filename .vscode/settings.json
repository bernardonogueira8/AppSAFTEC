{
    "files.exclude": {
        "**/*.pyc": { "when": "$(basename).py" },
        "**/__pycache__": true,
        "**/*.pytest_cache": true,
        "**/build": true,
        "**/bin": true,
        "**/assets": true,
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "cSpell.words": [
        "sync_playwright"
    ]
}
